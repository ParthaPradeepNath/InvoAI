{
  "name": "ai-invoice-generator",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "pnpm --parallel dev:backend dev:frontend",
    "dev:backend": "pnpm --filter ai-invoice-backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "build": "pnpm --filter frontend build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.6.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md}": "prettier --write"
  }
}
